set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEMA5F31C6
set_global_assignment -name TOP_LEVEL_ENTITY de1_usb_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name VERILOG_FILE ../src/protocol_engine.v
set_global_assignment -name VERILOG_FILE ../rtl/usb_firmware_bootloader.v
set_global_assignment -name VERILOG_FILE ../rtl/de1_usb_top.v
set_global_assignment -name MISC_FILE ../build/usb_ls.hex
set_global_assignment -name SDC_FILE de1_soc_usb.sdc
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name CYCLONEII_RESERVE_NCEO_AFTER_CONFIGURATION "USE AS REGULAR IO"
# Only enable after PHY hardware review and rebuilding with usable VID/PID.
set_parameter -name USB_ATTACH_ALLOWED 0
source de1_soc_pins.qsf
