set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEMA5F31C6
set_global_assignment -name TOP_LEVEL_ENTITY de1_protocol_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name VERILOG_FILE ../src/protocol_engine.v
set_global_assignment -name VERILOG_FILE ../src/program_store.v
set_global_assignment -name VERILOG_FILE ../rtl/firmware_bootloader.v
set_global_assignment -name VERILOG_FILE ../rtl/de1_protocol_top.v
set_global_assignment -name MISC_FILE ../firmware/uart_duplex.hex
set_global_assignment -name MISC_FILE ../firmware/uart_duplex_31250.hex
set_global_assignment -name MISC_FILE ../firmware/uart_rx.hex
set_global_assignment -name MISC_FILE ../firmware/spi_mode0.hex
set_global_assignment -name MISC_FILE ../firmware/i2c_write.hex
set_global_assignment -name MISC_FILE ../firmware/i2c_read.hex
set_global_assignment -name SDC_FILE de1_soc_demo.sdc
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name CYCLONEII_RESERVE_NCEO_AFTER_CONFIGURATION "USE AS REGULAR IO"

source de1_soc_pins.qsf

set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_NO_OUTPUT_GND "AS INPUT TRI-STATED"
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top

set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top
